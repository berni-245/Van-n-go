import { createAsync, createAsyncStore, query, redirect, useParams } from "@solidjs/router";
import { Suspense, createMemo } from "solid-js";
import { useApi, useAppState } from "../app-context/AppContext";
import { useToast } from "solid-notifications";

const vehicleQuery = query(async (vehicleId: number) => {
  const api = useApi();
  const [appState] = useAppState();
  const toaster = useToast();

  const vehicle = await api.getVehicle(appState.user!.id, vehicleId);
  if (!vehicle) {
    // TODO: toast message localization.
    toaster.notify("Request vehicle does not exist.", { type: "error" });
    return redirect("/driver/vehicles");
  }
  const availability = await api.getVehicleAvailability(vehicle.availability);
  if (!availability) {
    // TODO: toast message localization.
    toaster.notify("Failed to get availability.", { type: "error" });
    return redirect("/driver/vehicles");
  }
  const zoneIds = availability.zones.flatMap((zUrl) => {
    const idStr = zUrl.split("/").pop();
    const id = Number(idStr);

    return Number.isInteger(id) ? [id] : [];
  });
  return { vehicle, availability, zoneIds };
}, "vehicle-query");

const zonesQuery = query(() => useApi().getZones(), "zones-query");

export default function VehicleEdit() {
  const params = useParams();
  const vehicleId = parseInt(params.vehicleId);

  const v = createAsyncStore(() => vehicleQuery(vehicleId));
  const zones = createAsync(() => zonesQuery());
  const vehicleZones = () => {
    return v.latest?.zoneIds.flatMap((id) => {
      const zone = zones.latest?.[id];
      return zone ? [zone] : [];
    });
  };

  return (
    <>
      <Suspense fallback="Loading vehicle...">
        <h3>Vehicle</h3>
        <p>{JSON.stringify(v.latest?.vehicle)}</p>
        <Suspense fallback="Loading availability...">
          <h3>Availability</h3>
          <p>{JSON.stringify(v.latest?.availability)}</p>
          <h3>Vehicle Zones</h3>
          <p>{JSON.stringify(vehicleZones())}</p>
        </Suspense>
      </Suspense>
      <Suspense fallback="Loading zones...">
        <h3>Zones</h3>
        <p>{JSON.stringify(zones.latest)}</p>
      </Suspense>
    </>
  );
}
