#!/bin/bash
#
# Verify STAGED frontend files are Prettier-formatted before committing.
# Enable (per clone):  git config core.hooksPath .githooks
# (frontend/package.json's "prepare" script sets this automatically on `pnpm install`.)

# Staged (added/copied/modified/renamed) frontend files that Prettier manages,
# as paths relative to frontend/.
mapfile -t files < <(
  git diff --cached --name-only --diff-filter=ACMR -- 'frontend/' \
    | sed 's#^frontend/##' \
    | grep -E '\.(ts|tsx|json|css)$' || true
)

[ ${#files[@]} -eq 0 ] && exit 0

cd "$(git rev-parse --show-toplevel)/frontend" || exit 1

# Call the Prettier binary directly (not `pnpm run format:check`): we need to check just
# the staged files, and this avoids pnpm's pre-run dependency verification.
if [ ! -x node_modules/.bin/prettier ]; then
  echo -e "\e[33m⚠ Prettier not installed in frontend/ (run 'pnpm install'); skipping format check.\e[0m"
  exit 0
fi

if ! node_modules/.bin/prettier --check "${files[@]}"; then
  echo ""
  echo -e "\e[31m✗ Staged frontend files are not formatted.\e[0m Run \e[1mpnpm run format\e[0m in frontend/, then re-stage."
  exit 1
fi
